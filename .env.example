# Copy to .env and fill in real values. Never commit the real .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mudek_db

# JWT signing key. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 chars. The API refuses to start with the default value.
SECRET_KEY=REPLACE_WITH_OUTPUT_OF_SECRETS_TOKEN_URLSAFE_64

# Comma-separated list of allowed browser origins. Do NOT use * in production.
CORS_ORIGINS=https://mudek.ktun.edu.tr

# Public base URL used in password-reset email links. Set to the real HTTPS
# origin so links point at the live site (not localhost).
PUBLIC_BASE_URL=https://mudek.ktun.edu.tr

# Max failed login attempts allowed per IP per minute
LOGIN_RATE_LIMIT_PER_MINUTE=10

# production | staging | development — affects logging verbosity
ENVIRONMENT=production

# ── SMTP (self-servis "Şifremi Unuttum" e-postaları için) ────────────────────
# Boş bırakılırsa e-posta gönderilmez (sayfa yine çalışır; admin paneli yedek
# yoldur). Go-live öncesi KTÜ mail relay bilgileriyle doldurun.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=mudek@ktun.edu.tr
# STARTTLS (587) için true; implicit TLS (465) için SMTP_SSL=true yapın.
SMTP_STARTTLS=true
SMTP_SSL=false
