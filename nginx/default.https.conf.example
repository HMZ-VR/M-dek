# HTTPS-enabled nginx config. Copy to default.conf after TLS certs are
# provisioned on the host and mounted into the container at /etc/ssl/mudek/.
#
# Certificate layout expected:
#   /etc/ssl/mudek/fullchain.pem
#   /etc/ssl/mudek/privkey.pem
#
# Mount in docker-compose.yml:
#   volumes:
#     - /etc/letsencrypt/live/mudek.ktun.edu.tr:/etc/ssl/mudek:ro

# 1) Redirect all plain HTTP to HTTPS (and serve ACME challenges)
server {
    listen 80;
    server_name mudek.ktun.edu.tr;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 2) The application over TLS
server {
    listen 443 ssl http2;
    server_name mudek.ktun.edu.tr;

    ssl_certificate     /etc/ssl/mudek/fullchain.pem;
    ssl_certificate_key /etc/ssl/mudek/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'" always;

    # Dosya yükleme boyut sınırı (HTTP konfigürasyonu ve backend ile uyumlu: 50 MB)
    client_max_body_size 50m;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # Genel API rate limiting (00-rate-limit.conf zone'larından)
        limit_req zone=api_limit burst=20 nodelay;

        proxy_pass         http://api:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Login — sıkı rate limiting (brute-force koruması)
    location = /api/login {
        limit_req zone=api_login burst=3 nodelay;
        proxy_pass         http://api:8000/api/login;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Şifre sıfırlama talebi — sıkı rate limiting (spam koruması)
    location = /api/forgot-password {
        limit_req zone=api_reset burst=2 nodelay;
        proxy_pass         http://api:8000/api/forgot-password;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Dosya upload — orta rate limiting
    location ~ ^/api/committees/.*/(upload|attachments)$ {
        limit_req zone=api_upload burst=5 nodelay;
        proxy_pass         http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }

    location /health {
        proxy_pass http://api:8000/health;
        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
